{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiWork Dev",
  "identifier": "com.aiworkgroup.aiwork.dev",
  "bundle": {
    "icon": [
      "../resources/icons/dev/32x32.png",
      "../resources/icons/dev/128x128.png",
      "../resources/icons/dev/128x128@2x.png",
      "../resources/icons/dev/icon-dev.icns"
    ],
    "macOS": {
      "bundleName": "AiWork - Dev",
      "infoPlist": "./Info.dev.plist"
    }
  },
  "app": {
    "windows": [
      {
        "title": "AiWork - Dev",
