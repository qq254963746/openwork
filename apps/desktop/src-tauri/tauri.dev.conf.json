        "height": 820,
        "resizable": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aiwork-dev"
        ]
      }
    }
  }
