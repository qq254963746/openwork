{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiWork",
  "version": "0.13.43",
  "identifier": "com.aiworkgroup.aiwork",
  "build": {
    "beforeDevCommand": "node ./scripts/tauri-before-dev.mjs",
    "beforeBuildCommand": "node ./scripts/tauri-before-build.mjs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AiWork",
        "width": 1180,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/versions.json": "versions.json"
    },
    "externalBin": [
      "sidecars/opencode",
      "sidecars/aiwork-server",
      "sidecars/chrome-devtools-mcp"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aiwork"
        ]
      }
    }
  }
}
