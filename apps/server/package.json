{
  "name": "aiwork-server",
  "version": "0.13.67",
  "description": "Filesystem-backed API for AiWork remote clients",
  "type": "module",
  "bin": {
    "aiwork-server": "bin/aiwork-server.mjs"
  },
  "scripts": {
    "dev": "AIWORK_DEV_MODE=1 bun src/cli.ts",
    "test": "bun test",
    "build": "tsc -p tsconfig.json",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bin/aiwork-server",
    "build:bin:all": "bun ./script/build.ts --outdir dist/bin --target bun-darwin-arm64 --target bun-darwin-x64 --target bun-linux-x64 --target bun-linux-arm64 --target bun-windows-x64",
    "start": "bun dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build:bin"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiworklove/aiwork.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/aiworklove/aiwork/tree/dev/apps/server",
  "bugs": {
    "url": "https://github.com/aiworklove/aiwork/issues"
  },
  "keywords": [
    "aiwork",
    "server",
    "engine",
    "headless",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aiwork/server-sdk": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.19.18",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.27.0"
}
