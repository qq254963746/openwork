{
  "name": "@fengai/aiwork-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "AIWORK_DEV_MODE=1 pnpm --filter @aiwork/desktop dev",
    "dev:electron": "AIWORK_DEV_MODE=1 pnpm --filter @aiwork/desktop dev:electron",
    "dev:windows": ".\\scripts\\dev-windows.cmd",
    "dev:windows:x64": ".\\scripts\\dev-windows.cmd x64",
    "dev:ui": "AIWORK_DEV_MODE=1 pnpm --filter @aiwork/app dev",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @aiwork/app build",
    "preview": "pnpm --filter @aiwork/app preview",
    "typecheck": "pnpm run sdk:generate && pnpm --filter @aiwork/app typecheck",
    "test:health": "pnpm --filter @aiwork/app test:health",
    "test:sessions": "pnpm --filter @aiwork/app test:sessions",
    "test:refactor": "pnpm --filter @aiwork/app test:refactor",
    "test:events": "pnpm --filter @aiwork/app test:events",
    "test:todos": "pnpm --filter @aiwork/app test:todos",
    "test:permissions": "pnpm --filter @aiwork/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @aiwork/app test:session-error-recovery",
    "test:session-switch": "pnpm --filter @aiwork/app test:session-switch",
    "test:fs-engine": "pnpm --filter @aiwork/app test:fs-engine",
    "test:e2e": "pnpm --filter @aiwork/app test:e2e",
    "bump:patch": "pnpm --filter @aiwork/app bump:patch",
    "bump:minor": "pnpm --filter @aiwork/app bump:minor",
    "bump:major": "pnpm --filter @aiwork/app bump:major",
    "bump:set": "pnpm --filter @aiwork/app bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "tauri": "pnpm --filter @aiwork/desktop exec tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "electron",
      "esbuild",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.27.0"
}
